<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>uadiff</AssemblyName>
    <RootNamespace>CeyhunDiffViewer.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>uadiff</ToolCommandName>
    <PackageId>CeyhunDiffViewer</PackageId>
    <Version>0.1.2</Version>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CeyhunDiffViewer.Core\CeyhunDiffViewer.Core.csproj" />
  </ItemGroup>

</Project>
